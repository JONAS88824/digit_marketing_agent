# 环境变量模板。复制成 .env 后再填真实值。
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不会提交；本模板不含任何真实凭证。
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_API_KEY=

# ===== 数据源模式 =====
# mock = 用内置的假数据（默认，学习阶段用）
# live = 调真实 API（需要把下面的凭证填全）
DATA_SOURCE_MODE=mock

# ===== Google Ads API =====
# 申请入口：https://developers.google.com/google-ads/api/docs/get-started/dev-token
# developer token 需要 Google 审核，审核通过前只能用测试账号
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth 凭证：在 Google Cloud Console 创建"桌面应用"类型的 OAuth 客户端
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# refresh token：用上面的客户端跑一次 OAuth 授权流程换来的长期令牌
GOOGLE_ADS_REFRESH_TOKEN=
# 要查的广告账号 ID，10 位数字，不要写横线（1234567890 而不是 123-456-7890）
GOOGLE_ADS_CUSTOMER_ID=
# 选填：如果通过 MCC 经理账号访问子账号，这里填经理账号 ID
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ===== GA4 Data API =====
# 已核对官方文档与已安装的 google-analytics-data 0.23.0，
# GA4 取数只需要下面两项，别无其他。
# ① GA4 媒体资源 ID：纯数字，在 GA4 后台"管理 → 媒体资源设置"能看到。
#    代码里会拼成 properties/<这个数字> 传给 API。
GA4_PROPERTY_ID=
# ② 服务账号密钥 JSON 文件的绝对路径。
#    该服务账号还要在 GA4 后台"媒体资源访问管理"里加为"查看者"，否则会 403。
#    注意：这里只放路径；密钥文件本身请放在项目目录之外，避免误提交。
GA4_CREDENTIALS_JSON_PATH=
