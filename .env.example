# 环境变量模板。复制成 .env 后再填真实值。
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不会提交；本模板不含任何真实凭证。
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_API_KEY=

# ===== 数据源模式 =====
# mock = 用内置的假数据（默认，学习阶段用）
# live = 调真实 API（需要把下面的凭证填全）
DATA_SOURCE_MODE=mock

# ===== Google Ads API =====
# 申请入口：https://developers.google.com/google-ads/api/docs/get-started/dev-token
# developer token 需要 Google 审核，审核通过前只能用测试账号
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth 凭证：在 Google Cloud Console 创建"桌面应用"类型的 OAuth 客户端
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# refresh token：用上面的客户端跑一次 OAuth 授权流程换来的长期令牌
GOOGLE_ADS_REFRESH_TOKEN=
# 要查的广告账号 ID，10 位数字，不要写横线（1234567890 而不是 123-456-7890）
GOOGLE_ADS_CUSTOMER_ID=
# 选填：如果通过 MCC 经理账号访问子账号，这里填经理账号 ID
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ===== GA4 Data API =====
# 已核对官方文档与已安装的 google-analytics-data 0.23.0，
# GA4 取数只需要下面两项，别无其他。
# ① GA4 媒体资源 ID：纯数字，在 GA4 后台"管理 → 媒体资源设置"能看到。
#    代码里会拼成 properties/<这个数字> 传给 API。
GA4_PROPERTY_ID=
# ② 服务账号密钥 JSON 文件的绝对路径。
#    该服务账号还要在 GA4 后台"媒体资源访问管理"里加为"查看者"，否则会 403。
#    注意：这里只放路径；密钥文件本身请放在项目目录之外，避免误提交。
GA4_CREDENTIALS_JSON_PATH=

# ===== Google Search Console（自然搜索词库）=====
# ① 要查哪个站点。两种写法，必须与 Search Console 后台里显示的完全一致：
#    URL 前缀属性： https://example.com/     （注意结尾的斜杠，且只覆盖该前缀）
#    域名属性：     sc-domain:example.com    （覆盖全部子域与协议，需 DNS 验证）
SEARCH_CONSOLE_SITE_URL=
# ② 服务账号密钥 JSON 的绝对路径。所需 OAuth scope：
#    https://www.googleapis.com/auth/webmasters.readonly
#    注意：官方文档并未说明服务账号可用于 Search Console API。
#    社区通行做法是把服务账号邮箱加为该站点的用户，但这一点未经官方确认，
#    真接的时候要留出验证时间，必要时改用普通 OAuth 用户授权。
SEARCH_CONSOLE_CREDENTIALS_JSON_PATH=

# ===== 第三方竞品情报（竞品在投词）=====
# 竞品投放词 Google 不提供，只能买第三方数据（SEMrush / Ahrefs / DataForSEO 等）。
# 这里刻意做成厂商中立：只认端点和密钥，换厂商只改 keywords_data.py 里一个函数。
COMPETITOR_INTEL_BASE_URL=
COMPETITOR_INTEL_API_KEY=

# ===== 图像生成（营销视觉素材）=====
# 单独一个开关，和 DATA_SOURCE_MODE 分开——因为风险不同：
# 取数是只读的，出图是**按张收费的真花钱**。
#   mock = 本地用 Pillow 画占位图，零成本，用来跑通流程
#   live = 真调模型出图，按张扣费，且免费额度不覆盖图像生成
IMAGE_GENERATION_MODE=mock
# ===== 三档生图模型 =====
# 档位名固定是 draft / standard / premium，模型 ID 可以在这里覆盖。
# 对应关系是用本账号 models.list() 读 display_name 核对出来的：
#   draft    = Nano Banana 2 Lite  极致性价比、高并发
#              → 社媒缩略图批量、多方案草稿预览、大规模自动化素材测试
#   standard = Nano Banana 2       速度与质量平衡（主力推荐）
#              → 标准营销 Banner、电商产品背景替换、响应式广告素材
#   premium  = Nano Banana Pro     SOTA 顶级视觉效果，最贵
#              → 品牌主海报、高精修宣发图、对文字排版要求极高的精品素材
# 留空则用代码里的默认值。Imagen 系列已在 Gemini API 全线下线，一个都调不到。
IMAGE_MODEL_DRAFT=
IMAGE_MODEL_STANDARD=
IMAGE_MODEL_PREMIUM=
# 不指定档位时用哪一档
IMAGE_DEFAULT_TIER=standard
# 单次调用最多出几张图，防止一句话烧掉一笔钱。硬上限 6。
IMAGE_MAX_PER_CALL=3

# ===== 广告账号写入（投放策略与风控）=====
# 又是一个独立开关，理由和 IMAGE_GENERATION_MODE 一样、而且更硬：
# 取数只读、出图花自己的钱，**建广告是改线上账户**——预算、出价、素材都会真生效。
#   mock = 只产出演练回执，账号里什么都不会变（默认）
#   live = 真的建/改广告；需要 Google Ads 五项凭证齐备 + 落盘逻辑已实现，缺一项会直接报错
# 提示：本 agent 的所有写操作（提交、暂停）都要用户点确认才执行，改成 live 也不例外。
ADS_WRITE_MODE=mock

# ===== 风控阀门 =====
# 全部可留空用代码里的保守默认值。改大了拦得松、改小了拦得严——
# 值填得过大等于把阀门拆了，请按真实账户的承受能力来定。
# 单个广告系列的日预算上限（元）。默认 300。
RISK_MAX_DAILY_BUDGET=
# 全账户日预算合计上限（元）。默认 3000。防止"拆成几个小系列"绕过单系列上限。
RISK_MAX_ACCOUNT_DAILY_BUDGET=
# 手动出价每次点击最高价上限（元）。默认 15。防竞价失控。
RISK_MAX_CPC=
# 出价下限（元）。默认 0.5。出价过低会完全没有曝光，等于白建。
RISK_MIN_CPC=
# 目标每次转化费用上限（元）。默认 200。定太高等于放任超支。
RISK_MAX_TARGET_CPA=
# 目标 ROAS 下限（倍数，2 即 200%）。默认 1.5。定太低意味着接受亏损投放。
RISK_MIN_TARGET_ROAS=
# 目标 ROAS 上限（倍数）。默认 20。定太高系统会几乎不出量。
RISK_MAX_TARGET_ROAS=

